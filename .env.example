# Client (đi vào bundle trình duyệt — an toàn của hệ thống nằm ở RLS, không ở
# việc giấu key). Đặt ở .env.local khi chạy máy, và ở Vercel khi deploy.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Chỉ dùng cho scripts/import-quiz.mjs, chạy ở máy. KHÔNG đặt tiền tố VITE_ và
# không commit: key này bỏ qua toàn bộ RLS.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
