# Client (đi vào bundle trình duyệt — an toàn của hệ thống nằm ở RLS, không ở
# việc giấu key). Đặt ở .env.local khi chạy máy, và ở Vercel khi deploy.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Chỉ dùng cho scripts/import-quiz.mjs, chạy ở máy. KHÔNG đặt tiền tố VITE_ và
# không commit: key này bỏ qua toàn bộ RLS.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Connection string Postgres cho `npm run db:push` — thứ duy nhất chạy được DDL.
# Lấy chuỗi SESSION POOLER (cổng 5432), không lấy Direct connection: host
# db.<ref>.supabase.co chỉ có bản ghi IPv6.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:5432/postgres
